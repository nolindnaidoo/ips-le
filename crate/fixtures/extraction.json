{
	"normalization": [
		{
			"input": "2001:0db8:0000:0000:0000:0000:0000:0001",
			"expected": "2001:db8::1",
			"why": "RFC 5952 2.1/2.2: leading zeros are dropped and the zero run is compressed"
		},
		{
			"input": "2001:DB8::1",
			"expected": "2001:db8::1",
			"why": "RFC 5952 4.3: hexadecimal is lowercase"
		},
		{
			"input": "2001:db8:0:0:1:0:0:1",
			"expected": "2001:db8::1:0:0:1",
			"why": "RFC 5952 4.2.3: two runs of equal length, the leftmost is compressed"
		},
		{
			"input": "1:0:0:2:0:0:0:3",
			"expected": "1:0:0:2::3",
			"why": "RFC 5952 4.2.3: the longest run wins, not the first"
		},
		{
			"input": "2001:db8:0:1:1:1:1:1",
			"expected": "2001:db8:0:1:1:1:1:1",
			"why": "RFC 5952 4.2.2: a single zero group is never compressed"
		},
		{
			"input": "0:0:0:0:0:ffff:192.0.2.128",
			"expected": "::ffff:192.0.2.128",
			"why": "RFC 5952 5: an IPv4-mapped address keeps its dotted tail"
		},
		{
			"input": "::ffff:192.0.2.128",
			"expected": "::ffff:192.0.2.128",
			"why": "already canonical, and must stay that way"
		},
		{
			"input": "FF01:0:0:0:0:0:0:101",
			"expected": "ff01::101",
			"why": "RFC 5952 4.1/4.3 together"
		},
		{
			"input": "::",
			"expected": "::",
			"why": "the unspecified address is all zeros and compresses to nothing"
		},
		{
			"input": "::1",
			"expected": "::1",
			"why": "loopback, already canonical"
		},
		{
			"input": "AA-BB-CC-DD-EE-FF",
			"expected": "aa:bb:cc:dd:ee:ff",
			"why": "a MAC address is lowercased and reported colon-separated whatever it was written with"
		},
		{
			"input": "2001:0DB8::/32",
			"expected": "2001:db8::/32",
			"why": "a block's base is canonicalized like any other address"
		}
	],
